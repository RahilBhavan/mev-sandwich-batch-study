diff --git a/tests/test_research_range.py b/tests/test_research_range.py
new file mode 100644
index 0000000..b3d0fe9
--- /dev/null
+++ b/tests/test_research_range.py
@@ -0,0 +1,59 @@
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from proofdesk.research import hubcard, rules, spec as exspec
+
+SPEC = {
+    "id": "range-test", "number": 99, "series": "Onchain Receipts", "title": "Replay recovered 75%. Arrival order: 52%.",
+    "key": "75%", "sub": "Share of loss recovered (counterfactual replay)", "hero": ["75%", "mean of 200 random orders"],
+    "source": "a study · Oct 5–11, 2026", "stamp": "SINGLE SOURCE · STUDY SUMMARY.JSON", "form": "range", "foot_ink": "ink",
+    "alt": "A hand-written alt.",
+    "params": {"scale": [0, 100], "unit": "%", "draws": 200, "hi": 1, "rows": [
+        {"label": "Arrival order", "at": 51.72, "text": "52%"},
+        {"label": "Random orders", "from": 67.84, "to": 84.03, "text": "68–84%", "mean": 75.45, "mean_text": "Mean 75%"}]},
+}
+
+
+class RangeFormTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = Path(self.dir.name) / "range.exhibit.json"
+        self.path.write_text(json.dumps(SPEC))
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def test_range_is_lint_clean_and_draws_both_ends_of_the_axis_and_one_accent_marker(self):
+        ex, derived, ill = exspec.load(self.path)
+        self.assertEqual(rules.lint(ex, derived, ill), [])
+        html = hubcard.card_html(SPEC)
+        for label in (">0%<", ">50%<", ">100%<", ">Mean 75%<", ">68–84%<", ">52%<"):
+            self.assertIn(label, html)
+        self.assertEqual(sum("fill='#FFE500'" in r for r in html.split("<rect")[1:] if "data-mean" in r or "data-frm" in r or "data-at" in r), 1)  # one yellow mark: the mean
+        self.assertNotIn("<script", html)
+
+    def test_range_needs_an_integer_hi(self):
+        bad = {**SPEC, "params": {**SPEC["params"], "hi": None}}
+        ex = hubcard.exhibit_of(bad)
+        self.assertIn("R1", [r for r, _ in rules.lint(ex)])
+
+    def test_a_number_not_in_the_data_is_refused(self):
+        ex = hubcard.exhibit_of({**SPEC, "hero": ["81%", "mean of 200 random orders"]})
+        self.assertIn("R5", [r for r, _ in rules.lint(ex)])
+
+    def test_footer_ink_colours_the_footer_and_a_hand_written_alt_wins(self):
+        html = hubcard.card_html(SPEC)
+        self.assertIn("font-size:18px;color:#F5F5EF;line-height:1.35", html)
+        self.assertIn("color:#F5F5EF;font-weight:700", html)
+        default = hubcard.card_html({k: v for k, v in SPEC.items() if k != "foot_ink"})
+        self.assertIn("font-size:18px;color:#B7B8B1;line-height:1.35", default)
+        card = hubcard.hub_spec(self.path)
+        self.assertEqual(card["alt"], "A hand-written alt.")
+        self.assertEqual(card["scale"], [0, 50.0, 100])
+        self.assertEqual(card["exhibit"]["foot_ink"], "ink")
+
+
+if __name__ == "__main__":
+    unittest.main()
