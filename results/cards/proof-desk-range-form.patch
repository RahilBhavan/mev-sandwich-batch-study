diff --git a/proofdesk/research/forms_bars.py b/proofdesk/research/forms_bars.py
index 4cedd08..9d25b49 100644
--- a/proofdesk/research/forms_bars.py
+++ b/proofdesk/research/forms_bars.py
@@ -176,3 +176,42 @@ def paired(p: dict, m: dict, box) -> str:
         out.append(text(cx, bottom + 66, lab, m, TYPE["label"], "ink", "middle", 700 if i == p["hi"] else 400))
     out.append("</svg>")
     return "".join(out)
+
+
+def range_(p: dict, m: dict, box) -> str:
+    """p: scale [lo, hi], unit, rows [{label, at, text} | {label, from, to, text, mean, mean_text}], hi (row holding the finding).
+    One shared zero-based axis, printed at both ends. A row with `at` is a single run (grey tick); a row with `from`/`to` is
+    the spread of many runs (grey bar) and, when it holds the finding, carries its mean as the one yellow marker."""
+    rows = p["rows"]
+    lo, hi_s = p["scale"]
+    unit = p.get("unit", "%")
+    w, h = box.w, box.h
+    x0, x1 = 250, w - 60
+    sx = (x1 - x0) / (hi_s - lo)
+    xs = lambda v: x0 + (v - lo) * sx
+    row_h = min(190, (h - 150) / len(rows))  # rows sit close to their axis; spare height splits above and below
+    top = max(0, (h - (row_h * len(rows) + 150)) / 2)
+    axis_y = top + 40 + row_h * len(rows) + 30
+    out = [f"<svg width='{w}' height='{h}' viewBox='0 0 {w} {h}'>"]
+    step = (hi_s - lo) / 2
+    for k in range(3):
+        v = lo + step * k
+        out.append(line(xs(v), top + 10, xs(v), axis_y, m["ink"] if k == 0 else m["grid"], 1.6 if k == 0 else 1))
+        out.append(text(xs(v), axis_y + 38, f"{v:g}{unit}", m, TYPE["small"], "ink2", "middle"))
+    out.append(line(x0, axis_y, x1, axis_y, m["ink"], 1.6))
+    for i, r in enumerate(rows):
+        cy = top + 40 + row_h * (i + 0.5)
+        is_hi = i == p["hi"]
+        out.append(text(x0 - 22, cy + 9, r["label"], m, TYPE["value"], "ink", "end", 700 if is_hi else 400))
+        out.append(line(x0, cy, x1, cy, m["context2"], 2))
+        if "at" in r:
+            out.append(rect(xs(r["at"]) - 7, cy - 24, 14, 48, m, False, reveal="ctx bar", at=r["at"]))
+            out.append(text(xs(r["at"]), cy - 38, r["text"], m, TYPE["value"], "ink2", "middle", 700))
+            continue
+        out.append(rect(xs(r["from"]), cy - 24, xs(r["to"]) - xs(r["from"]), 48, m, False, reveal="ctx hbar", frm=r["from"], to=r["to"]))
+        out.append(text((xs(r["from"]) + xs(r["to"])) / 2, cy + 62, r["text"], m, TYPE["value"], "ink2", "middle", 700))
+        if "mean" in r:
+            out.append(rect(xs(r["mean"]) - 8, cy - 40, 16, 80, m, True, reveal="hi bar", mean=r["mean"]))
+            out.append(text(xs(r["mean"]), cy - 56, r["mean_text"], m, TYPE["value"], "accent_text", "middle", 700, cls="rv hi"))
+    out.append("</svg>")
+    return "".join(out)
