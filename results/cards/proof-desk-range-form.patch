         return "; ".join(f"{lab}: {pct:.1f}% ({right}){' (highlighted)' if i == 0 else ''}" for i, (lab, pct, right) in enumerate(p["rows"])) + "."
+    if ex.form == "range":
+        u, lo, hi = p.get("unit", "%"), *p["scale"]
+        rows = [f"{r['label']}: {r['text']}" + (f", {r['mean_text']}" if "mean" in r else "") for r in p["rows"]]
+        return f"On a {lo:g}{u} to {hi:g}{u} scale, " + "; ".join(rows) + "."
     if ex.form == "timeline":
         return "; ".join(f"{d}: {lab}{(', ' + det) if det else ''}{mark(i)}" for i, (d, lab, det) in enumerate(p["events"])) + "."
     if ex.form == "ledger":
@@ -109,7 +117,8 @@ def alt_text(ex: Exhibit) -> str:
 def hub_spec(path: Path) -> dict:
     ex, derived, illustration = exspec.load(Path(path))
     raw = raw_of(ex)
-    return {"id": ex.id, "kind": "exhibit", "title": ex.title, "alt": alt_text(ex), "source": ex.source,
